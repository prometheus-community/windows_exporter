(import '../mixin.libsonnet') {
  _config+:: {
    windowsExporterSelector: 'job=~"windows.*", cluster="test"',
    volumeSelector: 'volume!~"HarddiskVolume.*"',
    nicSelector: 'nic!="Loopback"',
    rateInterval: '2m',
    cpuHighUsageThreshold: 80,
    memoryHighUsageThreshold: 85,
    diskFreeWarningThreshold: 20,
    diskFreeCriticalThreshold: 10,
    criticalSeverity: 'page',
    enableActiveDirectory: true,
    enableTime: true,
    runbookURLPattern: 'https://runbooks.example.com/windows/%s/',
    memoryCommitHighUsageThreshold: 80,
    diskLatencyThresholdSeconds: 0.02,
    networkErrorRatioThreshold: 0.5,
    networkDiscardRatioThreshold: 0.5,
    clockOffsetThresholdSeconds: 0.1,
    adPendingReplicationThreshold: 10,
    adReplicationFailureRateThreshold: 0.5,
    collectors+: {
      dhcp: true,
      diskdrive: true,
      dns: true,
      hyperv: true,
      license: true,
      mscluster: true,
      pagefile: true,
      scheduled_task: true,
      storage_spaces: true,
      update: true,
    },
    pagefileUsageThreshold: 75,
    dhcpScopeFreeWarningThreshold: 20,
    dhcpScopeFreeCriticalThreshold: 5,
    updatePendingDuration: '2d',
    dnsZoneTransferFailureRateThreshold: 0.05,
    taskSelector: 'task!~"/Ignored.*"',
  },
}
