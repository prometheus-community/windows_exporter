# Recording rules that publish the metrics of windows_exporter 0.32 under
# their 0.31 names, units and instance labels, for dashboards and alerts that
# have not been migrated yet. 0.31 counters are also recorded with the _total
# suffix that Prometheus adds when it scrapes OpenMetrics. Load them into Prometheus next to the scrape of
# the new exporter and remove them once the queries use the new names.
#
# Generated from docs/upgrade/0.32.md by internal/metriccontract; do not edit.
#
# Not covered:
# - Metrics that only renamed their instance label, e.g. windows_service_*.
#   Recording them under the same name would duplicate every series.
# - Metrics whose 0.31 value can't be computed from 0.32, e.g. removed
#   metrics, split metrics and ratios that 0.31 computed wrongly.
# - Series that 0.32 leaves out, e.g. mscluster settings that are zero.
groups:
  - name: windows_exporter-0.32-ad
    rules:
      - record: windows_ad_atq_average_request_latency
        expr: windows_ad_atq_average_request_latency_seconds * 1000
      - record: windows_ad_sam_group_evaluation_latency
        expr: windows_ad_sam_group_evaluation_latency_seconds * 1000
      - record: windows_ad_security_descriptor_propagation_events_total
        expr: windows_ad_security_descriptor_propagation_suboperations_total
      - record: windows_ad_security_descriptor_propagation_items_queued_total
        expr: windows_ad_security_descriptor_propagation_items_queued
      - record: windows_ad_replication_highest_usn
        expr: windows_ad_replication_highest_usn_total
  - name: windows_exporter-0.32-container
    rules:
      - record: windows_container_count
        expr: windows_containers
      - record: windows_container_cpu_usage_seconds_kernelmode
        expr: windows_container_cpu_usage_kernelmode_seconds_total
      - record: windows_container_cpu_usage_seconds_kernelmode_total
        expr: windows_container_cpu_usage_kernelmode_seconds_total
      - record: windows_container_cpu_usage_seconds_usermode
        expr: windows_container_cpu_usage_usermode_seconds_total
      - record: windows_container_cpu_usage_seconds_usermode_total
        expr: windows_container_cpu_usage_usermode_seconds_total
  - name: windows_exporter-0.32-cpu
    rules:
      - record: windows_cpu_core_frequency_mhz
        expr: windows_cpu_core_frequency_hertz / 1e6
      - record: windows_cpu_time_total
        expr: windows_cpu_time_seconds_total
  - name: windows_exporter-0.32-cpu_info
    rules:
      - record: windows_cpu_info_l2_cache_size
        expr: windows_cpu_info_l2_cache_size_bytes / 1024
      - record: windows_cpu_info_l3_cache_size
        expr: windows_cpu_info_l3_cache_size_bytes / 1024
  - name: windows_exporter-0.32-dfsr
    rules:
      - record: windows_dfsr_connection_bandwidth_savings_using_dfs_replication_bytes_total
        expr: max without (connection) (label_replace(windows_dfsr_connection_bandwidth_savings_using_dfs_replication_ratio * 100, "name", "$1", "connection", "(.+)"))
      - record: windows_dfsr_folder_bandwidth_savings_using_dfs_replication_bytes_total
        expr: max without (folder) (label_replace(windows_dfsr_folder_bandwidth_savings_using_dfs_replication_ratio * 100, "name", "$1", "folder", "(.+)"))
      - record: windows_dfsr_volume_usn_journal_unread_percentage
        expr: max without (volume) (label_replace(windows_dfsr_volume_usn_journal_unread_ratio * 100, "name", "$1", "volume", "(.+)"))
  - name: windows_exporter-0.32-diskdrive
    rules:
      - record: windows_diskdrive_size
        expr: max without (device_id) (label_replace(windows_diskdrive_size_bytes, "name", "$1", "device_id", "(.+)"))
  - name: windows_exporter-0.32-dns
    rules:
      - record: windows_dns_dynamic_updates_queued
        expr: windows_dns_dynamic_updates_queued_total
  - name: windows_exporter-0.32-exchange
    rules:
      - record: windows_exchange_http_proxy_avg_auth_latency
        expr: max without (protocol) (label_replace(windows_exchange_http_proxy_avg_auth_latency_seconds * 1000, "name", "$1", "protocol", "(.+)"))
      - record: windows_exchange_http_proxy_mailbox_proxy_failure_rate
        expr: max without (protocol) (label_replace(windows_exchange_http_proxy_mailbox_proxy_failure_ratio * 100, "name", "$1", "protocol", "(.+)"))
      - record: windows_exchange_ldap_long_running_ops_per_sec
        expr: max without (process) (label_replace(windows_exchange_ldap_long_running_operations_per_second * 3600, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_long_running_ops_per_sec_total
        expr: max without (process) (label_replace(windows_exchange_ldap_long_running_operations_per_second * 3600, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_availability_service_requests_per_sec
        expr: windows_exchange_availability_service_requests_total
      - record: windows_exchange_availability_service_requests_per_sec_total
        expr: windows_exchange_availability_service_requests_total
      - record: windows_exchange_http_proxy_avg_cas_processing_latency_sec
        expr: max without (protocol) (label_replace(windows_exchange_http_proxy_avg_cas_processing_latency_seconds, "name", "$1", "protocol", "(.+)"))
      - record: windows_exchange_http_proxy_mailbox_server_locator_avg_latency_sec
        expr: max without (protocol) (label_replace(windows_exchange_http_proxy_mailbox_server_locator_avg_latency_seconds, "name", "$1", "protocol", "(.+)"))
      - record: windows_exchange_ldap_read_time_sec
        expr: max without (process) (label_replace(windows_exchange_ldap_read_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_read_time_sec_total
        expr: max without (process) (label_replace(windows_exchange_ldap_read_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_search_time_sec
        expr: max without (process) (label_replace(windows_exchange_ldap_search_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_search_time_sec_total
        expr: max without (process) (label_replace(windows_exchange_ldap_search_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_write_time_sec
        expr: max without (process) (label_replace(windows_exchange_ldap_write_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_ldap_write_time_sec_total
        expr: max without (process) (label_replace(windows_exchange_ldap_write_time_seconds_total, "name", "$1", "process", "(.+)"))
      - record: windows_exchange_mapihttp_emsmdb_active_user_count
        expr: windows_exchange_mapihttp_emsmdb_active_users
      - record: windows_exchange_rpc_active_user_count
        expr: windows_exchange_rpc_active_users
      - record: windows_exchange_rpc_avg_latency_sec
        expr: windows_exchange_rpc_avg_latency_seconds
      - record: windows_exchange_rpc_connection_count
        expr: windows_exchange_rpc_connections
      - record: windows_exchange_rpc_user_count
        expr: windows_exchange_rpc_users
      - record: windows_exchange_workload_completed_tasks
        expr: max without (workload) (label_replace(windows_exchange_workload_completed_tasks_total, "name", "$1", "workload", "(.+)"))
      - record: windows_exchange_workload_yielded_tasks
        expr: max without (workload) (label_replace(windows_exchange_workload_yielded_tasks_total, "name", "$1", "workload", "(.+)"))
      - record: windows_exchange_workload_queued_tasks_total
        expr: max without (workload) (label_replace(windows_exchange_workload_queued_tasks, "name", "$1", "workload", "(.+)"))
  - name: windows_exporter-0.32-fsrmquota
    rules:
      - record: windows_fsrmquota_count
        expr: windows_fsrmquota_quotas
  - name: windows_exporter-0.32-gpu
    rules:
      - record: windows_gpu_engine_time_seconds
        expr: windows_gpu_engine_time_seconds_total
  - name: windows_exporter-0.32-hyperv
