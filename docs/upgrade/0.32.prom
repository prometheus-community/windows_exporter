  - name: windows_exporter-0.32-printer
    rules:
      - record: windows_printer_job_count
        expr: windows_printer_jobs
      - record: windows_printer_job_count_total
        expr: windows_printer_jobs
  - name: windows_exporter-0.32-process
    rules:
      - record: windows_process_cpu_time_total
        expr: windows_process_cpu_time_seconds_total
  - name: windows_exporter-0.32-remote_fx
    rules:
      - record: windows_remote_fx_net_current_tcp_bandwidth
        expr: windows_remote_fx_net_current_tcp_bandwidth_bytes_per_second
      - record: windows_remote_fx_net_current_udp_bandwidth
        expr: windows_remote_fx_net_current_udp_bandwidth_bytes_per_second
      - record: windows_remote_fx_gfx_frame_quality
        expr: windows_remote_fx_gfx_frame_quality_ratio * 100
  - name: windows_exporter-0.32-smb
    rules:
      - record: windows_smb_server_shares_read_requests_count_total
        expr: windows_smb_server_shares_read_requests_total
      - record: windows_smb_server_shares_write_requests_count_total
        expr: windows_smb_server_shares_write_requests_total
      - record: windows_smb_server_shares_metadata_requests_count_total
        expr: windows_smb_server_shares_metadata_requests_total
      - record: windows_smb_server_shares_files_opened_count_total
        expr: windows_smb_server_shares_files_opened_total
      - record: windows_smb_server_shares_current_open_file_count
        expr: windows_smb_server_shares_open_files
      - record: windows_smb_server_shares_current_open_file_count_total
        expr: windows_smb_server_shares_open_files
      - record: windows_smb_server_shares_tree_connect_count
        expr: windows_smb_server_shares_tree_connects
      - record: windows_smb_server_shares_tree_connect_count_total
        expr: windows_smb_server_shares_tree_connects
  - name: windows_exporter-0.32-storage_spaces
    rules:
      - record: windows_storage_spaces_virtual_disk_storage_efficiency_percent
        expr: max without (virtual_disk) (label_replace(windows_storage_spaces_virtual_disk_storage_efficiency_ratio * 100, "name", "$1", "virtual_disk", "(.+)"))
  - name: windows_exporter-0.32-tcp
    rules:
      - record: windows_tcp_connections_state_count
        expr: windows_tcp_connections
  - name: windows_exporter-0.32-time
    rules:
      - record: windows_time_clock_frequency_adjustment_ppb
        expr: windows_time_clock_frequency_adjustment_ratio * 1e9
  - name: windows_exporter-0.32-vmware
    rules:
      - record: windows_vmware_cpu_effective_vm_speed_mhz_total
        expr: windows_vmware_cpu_effective_vm_speed_hertz / 1e6
      - record: windows_vmware_cpu_limit_mhz
        expr: windows_vmware_cpu_limit_hertz / 1e6
      - record: windows_vmware_cpu_reservation_mhz
        expr: windows_vmware_cpu_reservation_hertz / 1e6
      - record: windows_vmware_host_processor_speed_mhz
        expr: windows_vmware_host_processor_speed_hertz / 1e6
