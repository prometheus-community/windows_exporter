                    },
                    {
                        "kind": "RowsLayoutRow",
                        "spec": {
                            "collapse": false,
                            "layout": {
                                "kind": "GridLayout",
                                "spec": {
                                    "items": [
                                        {
                                            "kind": "GridLayoutItem",
                                            "spec": {
