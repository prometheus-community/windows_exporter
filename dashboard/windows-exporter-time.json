                                            "group": "prometheus",
                                            "kind": "DataQuery",
                                            "spec": {
                                                "editorMode": "code",
                                                "expr": "windows_time_ntp_client_time_sources{job=~\"$job\", instance=\"$instance\"}",
                                                "instant": false,
                                                "legendFormat": "__auto",
                                                "range": true
                                            },
                                            "version": "v0"
                                        },
                                        "refId": "A"
                                    }
                                }
                            ],
                            "queryOptions": {
                                "maxDataPoints": 100
                            },
                            "transformations": []
                        }
                    },
                    "description": "Number of time sources the NTP client uses. 0 means the clock is not synchronized.",
                    "id": 86,
                    "links": [],
                    "title": "NTP time sources",
                    "vizConfig": {
                        "group": "stat",
                        "kind": "VizConfig",
                        "spec": {
                            "fieldConfig": {
                                "defaults": {
                                    "color": {
                                        "mode": "thresholds"
                                    },
                                    "thresholds": {
                                        "mode": "absolute",
                                        "steps": [
                                            {
                                                "color": "red",
                                                "value": null
                                            },
                                            {
                                                "color": "green",
                                                "value": 1
                                            }
                                        ]
                                    },
                                    "unit": "short"
                                },
                                "overrides": []
                            },
                            "options": {
                                "colorMode": "value",
                                "graphMode": "area",
                                "justifyMode": "auto",
                                "orientation": "auto",
                                "percentChangeColorMode": "standard",
                                "reduceOptions": {
                                    "calcs": [
                                        "lastNotNull"
